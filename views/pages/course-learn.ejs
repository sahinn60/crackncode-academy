<!DOCTYPE html>
<html lang="bn" class="scroll-smooth">
<head><%- include('../partials/head') %></head>
<body class="min-h-screen bg-[#000b1a] font-display text-slate-200 antialiased">
  <%- include('../partials/navbar') %>
  <main class="mx-auto max-w-5xl px-4 py-8 md:px-6">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-sky">হোম</a><span class="mx-2">›</span>
      <a href="/courses" class="hover:text-sky">কোর্স</a><span class="mx-2">›</span>
      <a href="/courses/<%= course.slug %>" class="hover:text-sky"><%= course.title %></a><span class="mx-2">›</span>
      <span class="text-slate-300">Learning</span>
    </nav>

    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-white md:text-2xl"><%= course.title %></h1>
        <p class="mt-1 text-sm text-slate-400">আপনি এই কোর্সে enrolled আছেন</p>
      </div>
      <span style="border-radius:5px; padding:4px 12px; font-weight:bold; background:#28a745; color:#fff; font-size:13px;">✓ Enrolled</span>
    </div>

    <% if (course.resourceUrl) { %>
      <!-- Resource link available -->
      <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-white">
          <svg class="h-5 w-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
          Course Resource
        </h2>
        <p class="mt-2 text-sm text-slate-400">নিচের লিঙ্কে ক্লিক করে কোর্স কন্টেন্ট access করুন:</p>

        <a href="<%= course.resourceUrl %>" target="_blank" rel="noopener noreferrer"
          class="mt-4 flex items-center gap-3 rounded-xl border border-emerald-500/40 bg-[#0a1428] p-4 transition hover:border-emerald-500/70 hover:bg-emerald-500/10">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-500/20">
            <svg class="h-6 w-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-white">Open Course Content</p>
            <p class="truncate text-xs text-slate-500"><%= course.resourceUrl %></p>
          </div>
          <svg class="h-5 w-5 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <!-- Embed if Google Drive -->
        <% var isGDrive = course.resourceUrl.includes('drive.google.com'); %>
        <% if (isGDrive) { %>
          <div class="mt-6">
            <h3 class="mb-3 text-sm font-semibold text-white">Preview:</h3>
            <div class="overflow-hidden rounded-xl border border-white/10">
              <iframe src="<%= course.resourceUrl.replace('/view','/preview') %>" class="w-full" style="height:70vh; min-height:500px;" frameborder="0" allowfullscreen></iframe>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <!-- No resource yet -->
      <div class="rounded-2xl border border-white/10 bg-[#0a1428] p-10 text-center">
        <svg class="mx-auto h-16 w-16 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <h2 class="mt-4 text-lg font-bold text-white">কন্টেন্ট শীঘ্রই আসছে</h2>
        <p class="mt-2 text-slate-400">এই কোর্সের কন্টেন্ট এখনো আপলোড হয়নি। শীঘ্রই available হবে।</p>
        <a href="/courses/<%= course.slug %>" class="mt-6 inline-flex items-center gap-2 rounded-xl border border-white/10 px-5 py-2.5 text-sm text-slate-300 hover:bg-white/5">← কোর্সে ফিরে যান</a>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
