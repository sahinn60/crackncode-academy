<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Courses — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config={theme:{extend:{colors:{night:"#000b1a",card:"#0a1428",sky:"#00a2ff",fire:"#ff6600"}}}}</script>
</head>
<body class="min-h-screen bg-[#000b1a] text-slate-200 flex">
  <%- include('sidebar', { adminNav }) %>
  <div class="flex flex-1 flex-col lg:ml-60">
    <%- include('topbar', { pageTitle, authUser }) %>
    <main class="flex-1 p-4 md:p-6">

      <div class="mb-5 flex items-center justify-between">
        <p class="text-sm text-slate-400"><%= courses.length %> courses total</p>
        <button onclick="openAdd()" class="rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white">+ Add Course</button>
      </div>

      <div class="rounded-2xl border border-white/10 bg-[#0a1428] overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-white/10 text-xs text-slate-500">
              <th class="px-5 py-3 text-left">Course</th>
              <th class="px-5 py-3 text-left">Category</th>
              <th class="px-5 py-3 text-left">Price</th>
              <th class="px-5 py-3 text-left">Status</th>
              <th class="px-5 py-3 text-left">Actions</th>
            </tr></thead>
            <tbody>
              <% courses.forEach(function(c, idx) { %>
              <tr class="border-b border-white/5 hover:bg-white/5" id="row-<%= c.id %>">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <% if (c.imageUrl) { %><img src="<%= c.imageUrl %>" class="h-10 w-14 rounded-lg object-cover shrink-0"/><% } else { %><div class="h-10 w-14 rounded-lg bg-white/10 shrink-0"></div><% } %>
                    <div>
                      <p class="font-medium text-white"><%= c.title %></p>
                      <p class="text-xs text-slate-500"><%= c.slug %></p>
                      <% if (c.resourceUrl) { %><p class="text-xs text-emerald-400 mt-0.5">✅ Links added</p><% } %>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3 text-slate-400"><%= c.category || '—' %></td>
                <td class="px-5 py-3 text-white">৳ <%= c.price.toLocaleString() %></td>
                <td class="px-5 py-3">
                  <button onclick="togglePublish('<%= c.id %>',<%= c.isPublished %>)" class="rounded-full px-2.5 py-0.5 text-xs font-semibold <%= c.isPublished ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-500/20 text-slate-400' %>"><%= c.isPublished ? 'Published' : 'Draft' %></button>
                </td>
                <td class="px-5 py-3">
                  <div class="flex gap-2">
                    <button onclick="openEdit(<%= idx %>)" class="rounded-lg border border-white/10 px-3 py-1.5 text-xs text-slate-300 hover:bg-white/5">Edit</button>
                    <button onclick="deleteCourse('<%= c.id %>')" class="rounded-lg border border-red-500/30 px-3 py-1.5 text-xs text-red-400 hover:bg-red-500/10">Delete</button>
                  </div>
                </td>
              </tr>
              <% }); %>
              <% if (courses.length === 0) { %><tr><td colspan="5" class="px-5 py-10 text-center text-slate-500">No courses yet.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Modal -->
      <div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4 overflow-y-auto">
        <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-[#0a1428] p-6 my-4">
          <h2 id="modalTitle" class="mb-4 text-lg font-semibold text-white">Add Course</h2>
          <div id="modalMsg" class="hidden mb-3 rounded-lg px-4 py-2 text-sm"></div>
          <form id="modalForm" class="space-y-3">
            <input id="fId" type="hidden"/>
            <div class="grid grid-cols-2 gap-3">
              <input id="fSlug" placeholder="Slug *" required class="col-span-2 rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              <input id="fTitle" placeholder="Title *" required class="col-span-2 rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              <input id="fPrice" type="number" placeholder="Price *" required class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              <input id="fOldPrice" type="number" placeholder="Old Price" class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              <input id="fCategory" placeholder="Category" class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              <input id="fLevel" placeholder="Level" class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              <textarea id="fDesc" placeholder="Description" rows="2" class="col-span-2 rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none resize-none"></textarea>
            </div>
            <!-- Multiple Links -->
            <div>
              <label class="block text-xs text-slate-400 mb-1.5">Resource / Drive Links</label>
              <div id="linksContainer"></div>
              <button type="button" onclick="addLinkRow()" class="mt-2 flex items-center gap-1 rounded-lg border border-dashed border-white/20 px-3 py-2 text-xs text-slate-400 hover:border-sky/50 hover:text-sky">+ Add Link</button>
            </div>
            <!-- Image -->
            <div>
              <label class="block text-xs text-slate-400 mb-1.5">Image</label>
              <div id="imgPreviewWrap" class="hidden mb-2"><img id="imgPreview" src="" class="h-28 w-full rounded-xl object-cover border border-white/10"/></div>
              <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border-2 border-dashed border-white/20 bg-[#000b1a] px-4 py-5 text-sm text-slate-400 hover:border-sky/50 hover:text-sky transition">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span id="uploadLabel">Click to upload image</span>
                <input id="fImage" type="file" accept="image/*" class="hidden" onchange="previewImage(this)"/>
              </label>
              <input id="fImageUrl" type="hidden"/>
            </div>
            <div class="flex justify-end gap-2 pt-1">
              <button type="button" onclick="closeModal()" class="rounded-xl border border-white/10 px-4 py-2 text-sm text-slate-300">Cancel</button>
              <button type="submit" id="submitBtn" class="rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white">Save</button>
            </div>
          </form>
        </div>
      </div>

    </main>
  </div>

  <!-- Store courses data for JS -->
  <script>var COURSES = <%- JSON.stringify(courses) %>;</script>

  <script>
    var token = localStorage.getItem('cnc_token'), isEdit = false;

    function showMsg(t,e){var el=document.getElementById('modalMsg');el.textContent=t;el.className='mb-3 rounded-lg px-4 py-2 text-sm '+(e?'bg-red-500/20 text-red-400':'bg-green-500/20 text-green-400');el.classList.remove('hidden');}
    function closeModal(){document.getElementById('modal').classList.add('hidden');document.getElementById('modalMsg').classList.add('hidden');document.getElementById('imgPreviewWrap').classList.add('hidden');document.getElementById('fImage').value='';document.getElementById('fImageUrl').value='';document.getElementById('uploadLabel').textContent='Click to upload image';}

    // Multiple links
    function addLinkRow(label, url) {
      var c = document.getElementById('linksContainer');
      var d = document.createElement('div');
      d.className = 'flex gap-2 mb-2 items-center';
      d.innerHTML = '<input placeholder="Label" value="'+(label||'')+'" class="w-24 rounded-lg border border-white/10 bg-[#000b1a] px-2 py-2 text-xs text-white focus:outline-none"/>'
        + '<input placeholder="https://drive.google.com/..." value="'+(url||'')+'" class="flex-1 rounded-lg border border-white/10 bg-[#000b1a] px-2 py-2 text-xs text-white focus:outline-none"/>'
        + '<button type="button" onclick="verifyOne(this)" class="shrink-0 rounded-lg border border-white/10 px-2 py-2 text-xs text-slate-300 hover:bg-white/5">✓</button>'
        + '<button type="button" onclick="this.parentElement.remove()" class="shrink-0 rounded-lg border border-red-500/30 px-2 py-2 text-xs text-red-400">✕</button>';
      c.appendChild(d);
    }
    function getLinksJson() {
      var links = [];
      document.querySelectorAll('#linksContainer > div').forEach(function(d) {
        var ins = d.querySelectorAll('input');
        if (ins[1] && ins[1].value.trim()) links.push({label: ins[0].value.trim()||'Link', url: ins[1].value.trim()});
      });
      return JSON.stringify(links);
    }
    function loadLinks(json) {
      document.getElementById('linksContainer').innerHTML = '';
      var arr = [];
      try { arr = JSON.parse(json || '[]'); } catch(_) {}
      if (!Array.isArray(arr)) { if (typeof json === 'string' && json.startsWith('http')) arr = [{label:'Link',url:json}]; else arr = []; }
      arr.forEach(function(l) { addLinkRow(l.label, l.url); });
    }
    async function verifyOne(btn) {
      var input = btn.parentElement.querySelectorAll('input')[1];
      var url = input.value.trim();
      if (!url) return;
      btn.textContent = '...'; btn.disabled = true;
      try {
        var r = await fetch('/api/admin/verify-link', {method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer '+token}, body:JSON.stringify({url})});
        var d = await r.json();
        btn.textContent = d.valid ? '✅' : '❌';
        btn.title = d.valid ? 'Active ('+d.status+')' : d.message;
      } catch(_) { btn.textContent = '❌'; }
      finally { btn.disabled = false; }
    }

    function openAdd() {
      isEdit = false;
      document.getElementById('modalTitle').textContent = 'Add Course';
      document.getElementById('submitBtn').textContent = 'Create';
      ['fId','fSlug','fTitle','fPrice','fOldPrice','fCategory','fLevel','fDesc','fImageUrl'].forEach(function(id){document.getElementById(id).value='';});
      document.getElementById('fSlug').disabled = false;
      loadLinks('[]');
      document.getElementById('modal').classList.remove('hidden');
    }

    function openEdit(idx) {
      var c = COURSES[idx];
      isEdit = true;
      document.getElementById('modalTitle').textContent = 'Edit Course';
      document.getElementById('submitBtn').textContent = 'Save';
      document.getElementById('fId').value = c.id;
      document.getElementById('fSlug').value = c.slug || '';
      document.getElementById('fSlug').disabled = true;
      document.getElementById('fTitle').value = c.title || '';
      document.getElementById('fPrice').value = c.price || '';
      document.getElementById('fOldPrice').value = c.oldPrice || '';
      document.getElementById('fCategory').value = c.category || '';
      document.getElementById('fLevel').value = c.level || '';
      document.getElementById('fDesc').value = c.description || '';
      document.getElementById('fImageUrl').value = c.imageUrl || '';
      loadLinks(c.resourceUrl || '[]');
      if (c.imageUrl) {
        document.getElementById('imgPreview').src = c.imageUrl;
        document.getElementById('imgPreviewWrap').classList.remove('hidden');
        document.getElementById('uploadLabel').textContent = 'Click to change image';
      }
      document.getElementById('modal').classList.remove('hidden');
    }

    function previewImage(input) {
      if (!input.files || !input.files[0]) return;
      var r = new FileReader();
      r.onload = function(e) { document.getElementById('imgPreview').src = e.target.result; document.getElementById('imgPreviewWrap').classList.remove('hidden'); document.getElementById('uploadLabel').textContent = input.files[0].name; };
      r.readAsDataURL(input.files[0]);
    }
    async function uploadImage(file) {
      var fd = new FormData(); fd.append('image', file);
      var r = await fetch('/api/admin/upload', {method:'POST', headers:{'Authorization':'Bearer '+token}, body:fd});
      var d = await r.json(); if (!r.ok) throw new Error(d.error||'Upload failed'); return d.url;
    }
    async function togglePublish(id, cur) {
      await fetch('/api/admin/courses/'+id, {method:'PATCH', headers:{'Content-Type':'application/json','Authorization':'Bearer '+token}, body:JSON.stringify({isPublished:!cur})});
      location.reload();
    }
    async function deleteCourse(id) {
      if (!confirm('Delete?')) return;
      var r = await fetch('/api/admin/courses/'+id, {method:'DELETE', headers:{'Authorization':'Bearer '+token}});
      if (r.ok) document.getElementById('row-'+id).remove();
    }

    document.getElementById('modalForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var btn = document.getElementById('submitBtn');
      btn.disabled = true; btn.textContent = 'Saving...';
      try {
        var file = document.getElementById('fImage').files[0];
        var imageUrl = document.getElementById('fImageUrl').value;
        if (file) imageUrl = await uploadImage(file);
        var body = {
          slug: document.getElementById('fSlug').value,
          title: document.getElementById('fTitle').value,
          price: document.getElementById('fPrice').value,
          oldPrice: document.getElementById('fOldPrice').value,
          category: document.getElementById('fCategory').value,
          level: document.getElementById('fLevel').value,
          description: document.getElementById('fDesc').value,
          imageUrl: imageUrl,
          resourceUrl: getLinksJson(),
        };
        var id = document.getElementById('fId').value;
        var r = await fetch('/api/admin/courses'+(isEdit?'/'+id:''), {
          method: isEdit?'PATCH':'POST',
          headers: {'Content-Type':'application/json','Authorization':'Bearer '+token},
          body: JSON.stringify(body),
        });
        var d = await r.json();
        if (!r.ok) return showMsg(d.error||'Failed', true);
        showMsg(isEdit?'Saved!':'Created!', false);
        setTimeout(function(){location.reload();}, 700);
      } catch(err) { showMsg(err.message||'Error', true); }
      finally { btn.disabled = false; btn.textContent = isEdit?'Save':'Create'; }
    });

    // Sidebar toggle
    var toggle = document.getElementById('sidebarToggle');
    var sidebar = document.getElementById('sidebar');
    if (toggle) toggle.addEventListener('click', function(){sidebar.classList.toggle('-translate-x-full');});
  </script>
</body>
</html>
