<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Hero Section — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config={theme:{extend:{colors:{night:"#000b1a",card:"#0a1428",sky:"#00a2ff",fire:"#ff6600"}}}}</script>
</head>
<body class="min-h-screen bg-[#000b1a] text-slate-200 flex">
  <%- include('sidebar', { adminNav }) %>
  <div class="flex flex-1 flex-col lg:ml-60">
    <%- include('topbar', { pageTitle, authUser }) %>
    <main class="flex-1 p-4 md:p-6">

      <div id="msg" class="hidden mb-4 rounded-xl px-4 py-3 text-sm font-medium"></div>

      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Form -->
        <div class="space-y-4">
          <div class="rounded-2xl border border-white/10 bg-[#0a1428] p-5">
            <h2 class="font-semibold text-white mb-4">Main Heading & Text</h2>
            <div class="space-y-3">
              <div>
                <label class="block text-xs text-slate-400 mb-1">Badge Text</label>
                <input id="badgeText" value="<%= hero.badgeText || '' %>" placeholder="e.g. Trending" class="w-full rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              </div>
              <div>
                <label class="block text-xs text-slate-400 mb-1">Main Heading *</label>
                <input id="mainHeading" value="<%= hero.mainHeading || '' %>" placeholder="e.g. ১৪৩৩ বৈশাখী অফার!" required class="w-full rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              </div>
              <div>
                <label class="block text-xs text-slate-400 mb-1">Description</label>
                <textarea id="subText" rows="3" placeholder="Description text..." class="w-full rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none resize-none"><%= hero.subText || '' %></textarea>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#0a1428] p-5">
            <h2 class="font-semibold text-white mb-4">Media & Offer</h2>
            <div class="space-y-3">
              <div>
                <label class="block text-xs text-slate-400 mb-1">Offer Title (above video)</label>
                <input id="offerTitle" value="<%= hero.offerTitle || '' %>" placeholder="e.g. নতুন ক্যারিয়ার শুরু করুন" class="w-full rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              </div>
              <div>
                <label class="block text-xs text-slate-400 mb-1">Video URL (YouTube/MP4)</label>
                <input id="videoUrl" value="<%= hero.videoUrl || '' %>" placeholder="https://youtube.com/watch?v=..." class="w-full rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              </div>
              <div>
                <label class="block text-xs text-slate-400 mb-1">Thumbnail Image</label>
                <div class="flex gap-2">
                  <input id="thumbnailUrl" value="<%= hero.thumbnailUrl || '' %>" placeholder="Image URL or upload" class="flex-1 rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
                  <label class="shrink-0 cursor-pointer rounded-xl border border-white/10 px-3 py-2.5 text-xs text-slate-300 hover:bg-white/5">
                    Upload
                    <input type="file" accept="image/*" class="hidden" onchange="uploadThumb(this)"/>
                  </label>
                </div>
              </div>
              <div>
                <label class="block text-xs text-slate-400 mb-1">Countdown Timer (Offer Expiry)</label>
                <input id="countdownDate" type="datetime-local" value="<%= hero.countdownDate ? new Date(hero.countdownDate).toISOString().slice(0,16) : '' %>" class="w-full rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#0a1428] p-5">
            <h2 class="font-semibold text-white mb-4">Action Buttons</h2>
            <div class="grid grid-cols-2 gap-3">
              <div class="col-span-2 grid grid-cols-2 gap-3">
                <input id="primaryBtnText" value="<%= hero.primaryBtnText || '' %>" placeholder="Primary Button Text" class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
                <input id="primaryBtnUrl" value="<%= hero.primaryBtnUrl || '' %>" placeholder="Primary Button URL" class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              </div>
              <div class="col-span-2 grid grid-cols-2 gap-3">
                <input id="secondaryBtnText" value="<%= hero.secondaryBtnText || '' %>" placeholder="Secondary Button Text" class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
                <input id="secondaryBtnUrl" value="<%= hero.secondaryBtnUrl || '' %>" placeholder="Secondary Button URL" class="rounded-xl border border-white/10 bg-[#000b1a] px-3 py-2.5 text-sm text-white focus:border-sky focus:outline-none"/>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#0a1428] p-5">
            <div class="flex items-center justify-between">
              <h2 class="font-semibold text-white">Status</h2>
              <label class="relative inline-flex items-center cursor-pointer">
                <input id="isActive" type="checkbox" <%= hero.isActive !== false ? 'checked' : '' %> class="sr-only peer"/>
                <div class="w-11 h-6 bg-slate-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                <span class="ml-2 text-sm text-slate-300">Show on Homepage</span>
              </label>
            </div>
          </div>

          <div class="flex gap-3">
            <button onclick="saveHero()" id="saveBtn" class="flex-1 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 py-3 text-sm font-bold text-white hover:opacity-90">Save Hero Section</button>
            <button onclick="previewHero()" class="rounded-xl border border-white/10 px-5 py-3 text-sm text-slate-300 hover:bg-white/5">Preview</button>
          </div>
        </div>

        <!-- Live Preview -->
        <div>
          <div class="sticky top-20">
            <h2 class="mb-3 text-sm font-semibold text-slate-400">Live Preview</h2>
            <div id="preview" class="rounded-2xl border border-white/10 bg-night overflow-hidden">
              <div class="relative p-6">
                <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-sky/30 bg-sky/10 px-3 py-1 text-xs text-sky">
                  <span class="rounded-full bg-sky px-2 py-0.5 text-xs font-bold text-night" id="pBadge">Trending</span>
                </div>
                <h1 id="pHeading" class="text-2xl font-bold text-sky">১৪৩৩ বৈশাখী অফার!</h1>
                <p id="pSubText" class="mt-2 text-sm text-slate-300">Description here...</p>
                <div class="mt-4 flex gap-2">
                  <span id="pBtn1" class="rounded-lg bg-sky px-4 py-2 text-xs font-semibold text-night">Button 1</span>
                  <span id="pBtn2" class="rounded-lg border border-white/20 px-4 py-2 text-xs text-white">Button 2</span>
                </div>
                <div class="mt-4 rounded-xl bg-[#f0f0f0] p-4 text-night text-center">
                  <p id="pOffer" class="text-sm font-bold">Offer Title</p>
                  <div class="mt-3 flex justify-center">
                    <div class="h-12 w-12 rounded-full bg-emerald-500 flex items-center justify-center text-white">▶</div>
                  </div>
                  <div id="pTimer" class="mt-3 flex justify-center gap-2">
                    <span class="h-8 w-8 rounded bg-amber-800 ring-2 ring-amber-600/50"></span>
                    <span class="h-8 w-8 rounded bg-amber-800 ring-2 ring-amber-600/50"></span>
                    <span class="h-8 w-8 rounded bg-amber-800 ring-2 ring-amber-600/50"></span>
                    <span class="h-8 w-8 rounded bg-amber-800 ring-2 ring-amber-600/50"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script>
    var token = localStorage.getItem('cnc_token');

    function showMsg(t, e) {
      var el = document.getElementById('msg');
      el.textContent = t;
      el.className = 'mb-4 rounded-xl px-4 py-3 text-sm font-medium ' + (e ? 'bg-red-500/20 text-red-400 border border-red-500/30' : 'bg-green-500/20 text-green-400 border border-green-500/30');
      el.classList.remove('hidden');
    }

    function previewHero() {
      document.getElementById('pBadge').textContent = document.getElementById('badgeText').value || 'Trending';
      document.getElementById('pHeading').textContent = document.getElementById('mainHeading').value || 'Heading';
      document.getElementById('pSubText').textContent = document.getElementById('subText').value || '';
      document.getElementById('pOffer').textContent = document.getElementById('offerTitle').value || 'Offer';
      document.getElementById('pBtn1').textContent = document.getElementById('primaryBtnText').value || 'Button 1';
      document.getElementById('pBtn2').textContent = document.getElementById('secondaryBtnText').value || 'Button 2';
    }

    async function uploadThumb(input) {
      if (!input.files || !input.files[0]) return;
      var fd = new FormData(); fd.append('image', input.files[0]);
      var r = await fetch('/api/admin/upload', {method:'POST', headers:{'Authorization':'Bearer '+token}, body:fd});
      var d = await r.json();
      if (r.ok) document.getElementById('thumbnailUrl').value = d.url;
    }

    async function saveHero() {
      var btn = document.getElementById('saveBtn');
      btn.disabled = true; btn.textContent = 'Saving...';
      var body = {
        mainHeading: document.getElementById('mainHeading').value,
        subText: document.getElementById('subText').value,
        badgeText: document.getElementById('badgeText').value,
        offerTitle: document.getElementById('offerTitle').value,
        videoUrl: document.getElementById('videoUrl').value,
        thumbnailUrl: document.getElementById('thumbnailUrl').value,
        countdownDate: document.getElementById('countdownDate').value || null,
        primaryBtnText: document.getElementById('primaryBtnText').value,
        primaryBtnUrl: document.getElementById('primaryBtnUrl').value,
        secondaryBtnText: document.getElementById('secondaryBtnText').value,
        secondaryBtnUrl: document.getElementById('secondaryBtnUrl').value,
        isActive: document.getElementById('isActive').checked,
      };
      if (!body.mainHeading) { showMsg('Main Heading is required', true); btn.disabled=false; btn.textContent='Save Hero Section'; return; }
      try {
        var r = await fetch('/api/admin/hero', {
          method: 'POST',
          headers: {'Content-Type':'application/json','Authorization':'Bearer '+token},
          body: JSON.stringify(body),
        });
        var d = await r.json();
        if (!r.ok) return showMsg(d.error || 'Failed', true);
        showMsg('Hero Section saved!', false);
      } catch(err) { showMsg(err.message, true); }
      finally { btn.disabled = false; btn.textContent = 'Save Hero Section'; }
    }

    // Auto-preview on input
    document.querySelectorAll('input,textarea').forEach(function(el) {
      el.addEventListener('input', previewHero);
    });
    previewHero();

    // Sidebar toggle
    var toggle = document.getElementById('sidebarToggle');
    var sidebar = document.getElementById('sidebar');
    if (toggle) toggle.addEventListener('click', function(){sidebar.classList.toggle('-translate-x-full');});
  </script>
</body>
</html>
